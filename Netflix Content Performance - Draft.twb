      <column datatype='integer' name='[(# Contacts Answered)]' role='measure' type='quantitative' />
      <column caption='(# Contacts at BPO Skill) (cópia)' datatype='integer' name='[(# Contacts at BPO Skill) (cópia)_3530329558825517060]' role='measure' type='quantitative'>
