      </column>
      <column datatype='integer' name='[(# Contacts at BPO Skill)]' role='measure' type='quantitative' />
      <column datatype='integer' name='[(ASA Secs)]' role='measure' type='quantitative' />
      <column caption='(Rcr %)' datatype='real' name='[(RCR %)]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[avg:(ASA Secs):qk]&quot;' value='ASA Secs' />
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[avg:(RCR \%):qk]&quot;' value='RCR %' />
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[avg:Occupancy \%:qk]&quot;' value='Occupancy %' />
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[avg:Utilization \%:qk]&quot;' value='Utilization %' />
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[sum:(\# Contacts Answered):qk]&quot;' value='Contacts Answered' />
          <alias key='&quot;[federated.0vshxid0onwwz0149ysew16058ds].[sum:(\# Contacts at BPO Skill):qk]&quot;' value='Contacts Offered' />
        </aliases>
      </column>
      <column caption='Contacts Offered - Best 10' datatype='integer' name='[Asa Secs - Worst 10 (cópia)_3530329558822690818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([(# Contacts at BPO Skill)]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Asa Secs - Worst 10' datatype='integer' name='[Calculation_3530329558806568960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([(ASA Secs)]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volume concentration %' datatype='real' name='[Calculation_3530329558822936579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Skill] : SUM([(# Contacts at BPO Skill)])}&#10;/&#10;{ FIXED : SUM([(# Contacts at BPO Skill)])}' />
      </column>
      <column caption='Rank ASA global' datatype='integer' name='[Calculation_3530329559079145478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM({ FIXED [Skill], [UTC Week (Sun-Sat)] : AVG([(ASA Secs)]) }))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ASA worst 10 - Line chart' datatype='boolean' name='[Calculation_3530329559079575559]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3530329559079145478] &gt;= (TOTAL(COUNTD([Skill])) - 9)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Contacts offered / Answered' datatype='real' name='[Calculation_3530329559132168200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([(# Contacts at BPO Skill)]) / SUM([(# Contacts Answered)])' />
      </column>
      <column caption='ASA - 75 Percentile' datatype='real' name='[Calculation_3530329559137742857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED : PERCENTILE([(ASA Secs)], 0.50) })' />
      </column>
      <column caption='ASA Severity' datatype='string' name='[Calculation_3530329559138050058]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([(ASA Secs)]) &gt;= [Calculation_3530329559137742857] THEN &quot;High ASA&quot;&#10;ELSE &quot;Normal ASA&quot;&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3530329559146205195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parâmetro 1]&#10;WHEN &quot;Language&quot; THEN [Language]&#10;WHEN &quot;Call Center&quot; THEN [Call Center]&#10;WHEN &quot;Capacity Plan&quot; THEN [Capacity Plan]&#10;WHEN &quot;Skill&quot; THEN [Skill]&#10;END' />
      </column>
      <column caption='Metrics for Parameter' datatype='real' name='[Calculation_3530329559153950732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parâmetro 2]&#10;WHEN &quot;ASA&quot; THEN AVG([(ASA Secs)])&#10;WHEN &quot;AHT&quot; THEN AVG([AHT])&#10;WHEN &quot;RCR&quot; THEN (AVG([(RCR %)])*100)&#10;END' />
      </column>
      <column caption='Last refresh date' datatype='string' name='[Calculation_3530329559433494541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Data refreshed on &quot; + STR(TODAY())' />
      </column>
      <column caption='Skill Load Profile' datatype='real' name='[Calculation_3530329559497691150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([(# Contacts at BPO Skill)]-[(# Contacts Answered)])/[(# Contacts Answered)])' />
